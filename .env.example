# Copy to .env.local and fill in your own values. Never point these at
# production data or production credentials. See docs/development/setup.md.
#
# Only the variables below are read by the application. A variable for auth,
# payments, storage or email belongs here when its integration actually lands.

# Canonical public origin: scheme and host only, no trailing path.
# Inlined into the browser bundle by `next build`, so a production build
# requires it and will fail without it. Development falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Postgres connection used by the running app. The role must be
# able to insert into the waitlist tables and bypass their RLS; that bypass is
# infrastructure authority, never end-user authorisation. Keep it out of any
# browser module. Use a transaction-pooler port where your host provides one:
# the client disables prepared statements for that reason.
DATABASE_URL=

# Optional. Credentials for `pnpm db:migrate`, `pnpm db:generate` and
# `pnpm db:studio` when migrations run as a stronger role than the app.
# Falls back to DATABASE_URL when unset.
# DATABASE_MIGRATION_URL=
